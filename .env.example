# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Postgres schema that holds Kavana's tables (default: kavana)
# NEXT_PUBLIC_SUPABASE_SCHEMA=kavana
# Server only. Used only by /api/admin and to read the admin prompt note. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
# Optional. Defaults to gemini-flash-latest.
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated emails that may open /admin
ADMIN_EMAILS=you@example.com
