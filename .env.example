# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Postgres schema that holds Kavana's tables (default: kavana)
# NEXT_PUBLIC_SUPABASE_SCHEMA=kavana
# Server only. Used only by /api/admin and to read the admin prompt note. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude, the main AI (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=your-anthropic-key
# Optional. Defaults to claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional fallback: Google Gemini (https://aistudio.google.com/apikey).
# Used only when GEMINI_FALLBACK=true. Turn it on only for a key on a paid tier:
# on the unpaid tier Google may use and review what is sent.
# GEMINI_API_KEY=your-gemini-key
# GEMINI_FALLBACK=true
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated emails that may open /admin
ADMIN_EMAILS=you@example.com
